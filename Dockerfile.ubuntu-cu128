FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/opt/viegrader/cache/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv build-essential git curl \
    libgl1 libglib2.0-0 fonts-dejavu-core && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/viegrader/app
COPY . .
RUN python3 -m venv .venv && \
    .venv/bin/pip install --upgrade pip setuptools wheel && \
    .venv/bin/pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu128 && \
    .venv/bin/pip install -r requirements-ubuntu-cu128.txt && \
    .venv/bin/pip install -e ".[gui,reports,qlora,evaluation,docs,api,moodle,hub]"

EXPOSE 7860
CMD [".venv/bin/python", "-m", "viegrader.cli", "ubuntu-gui", "--config", "config.ubuntu.example.json"]
