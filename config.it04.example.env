# Sao chép thành config.it04.env và sửa đường dẫn cho Ubuntu Server.
VIEGRADER_ROOT=/opt/viegrader
IT04_DATASET=/opt/viegrader/input/VieGrader_IT04_Dataset_Core_v1.zip
IT04_RUBRICS=/opt/viegrader/data/toan_roi_rac/rubrics
IT04_RUN=/opt/viegrader/runs/it04

# Baseline có thể train bằng CPU.
IT04_ALPHA=12.0
# auto chọn trên validation, không dùng nhãn test. Có thể cố định 0.0 ... 1.0.
IT04_RUBRIC_WEIGHT=auto

# QLoRA tùy chọn, cần GPU NVIDIA và bộ model tải trước/có quyền truy cập.
IT04_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
IT04_EPOCHS=3
IT04_MAX_LENGTH=2048
IT04_SEED=42
