# Sao chép thành config.cmd.env và sửa đường dẫn. Không commit tệp chứa token.
VIEGRADER_ROOT=/opt/viegrader/app
RAW_INPUT=/opt/viegrader/data/raw/bai_lam.csv
NEW_INPUT=/opt/viegrader/data/raw/bai_moi.csv
RUBRIC=/opt/viegrader/app/rubrics/bai_luan_6_tieu_chi.yaml
DATASET_DOWNLOAD_DIR=/opt/viegrader/data/external/vietnamese-it-essays
DATASET_IMPORT_DIR=/opt/viegrader/data/imported/vietnamese_it_aes
ANNOTATIONS=/opt/viegrader/data/annotations.csv
GOLD=/opt/viegrader/data/gold.csv
GOLD_TEST=/opt/viegrader/data/gold_test.csv
RAG_SOURCE=/opt/viegrader/data/rag/tai_lieu_da_phe_duyet.csv
SUS_INPUT=/opt/viegrader/data/sus.csv
REFERENCE_FEEDBACK=/opt/viegrader/data/reference_feedback.csv

RATERS=GK1,GK2
SAMPLE_SIZE=200
SEED=42
QWK_HH=0.70
BASE_MODEL=Viet-Mistral/Vistral-7B-Chat
QLORA_RUNS=3
HF_REPO=username/viegrader-vistral-qlora

# Khai báo HF_TOKEN, MOODLE_BASE_URL và MOODLE_TOKEN qua
# /etc/viegrader/viegrader.env hoặc shell; không ghi giá trị thật ở đây.
