VIEGRADER_PORTAL_HOST=127.0.0.1
VIEGRADER_PORTAL_PORT=8088
VIEGRADER_PORTAL_USERS_JSON={"giangvien_1":"THAY_MAT_KHAU_1","giangvien_2":"THAY_MAT_KHAU_2"}
VIEGRADER_PORTAL_DATA=/var/lib/viegrader
VIEGRADER_RUBRIC_DIR=/opt/viegrader/data/toan_roi_rac/rubrics
VIEGRADER_BASELINE_MODEL=/opt/viegrader/runs/it04/03_model/total_baseline.pkl
VIEGRADER_QLORA_ADAPTER=/opt/viegrader/runs/it04/03_model/qlora_adapter_v2_2048
VIEGRADER_RUBRIC_CALIBRATION=/opt/viegrader/runs/it04/03_model/rubric_calibration.json
VIEGRADER_QLORA_MODEL=Qwen/Qwen2.5-7B-Instruct
VIEGRADER_PORTAL_MAX_INPUT_TOKENS=3584
VIEGRADER_MOODLE_MODE=simulate
# Chỉ khai báo khi bật RAG trong nhánh QLoRA:
# VIEGRADER_RAG_INDEX=/opt/viegrader/data/toan_roi_rac/rag_it04.json
# Chỉ khai báo sau khi nghiệm thu Moodle sandbox:
# MOODLE_BASE_URL=https://moodle.example.edu
# MOODLE_TOKEN=THAY_TOKEN
