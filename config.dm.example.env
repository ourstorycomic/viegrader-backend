# Sao chép thành config.dm.env. Không ghi token hoặc khóa thật vào Git.
VIEGRADER_ROOT=/opt/viegrader
DM_SOURCE_DIR=/opt/viegrader/data/toan_roi_rac/source
DM_GOLD=/opt/viegrader/data/toan_roi_rac/source/Nhan_Vang_Hoan_Chinh.csv
DM_RUBRIC_DIR=/opt/viegrader/data/toan_roi_rac/rubrics
DM_CATALOG=/opt/viegrader/data/toan_roi_rac/exam_catalog.yaml
DM_PREPARED=/opt/viegrader/data/toan_roi_rac/prepared
DM_SPLITS=/opt/viegrader/data/toan_roi_rac/splits
DM_ARTIFACTS=/opt/viegrader/artifacts/toan_roi_rac
DM_REPORTS=/opt/viegrader/reports/toan_roi_rac

DM_MODEL=Qwen/Qwen2.5-7B-Instruct
DM_SEED=42
DM_EPOCHS=3
DM_MAX_LENGTH=2048
DM_RUNS=3

# Bắt buộc export ở shell hoặc /etc/viegrader/viegrader.env:
# export VIEGRADER_DM_HMAC_SECRET='mot-khoa-dai-ngau-nhien'

